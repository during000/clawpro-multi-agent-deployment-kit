[Unit]
Description=ClawPro frontend and reverse proxy
After=network-online.target clawpro-hatchery.service clawpro-orchestrator.service docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f clawpro-multi-agent-nginx
ExecStart=/usr/bin/docker run --rm --name clawpro-multi-agent-nginx --network host -v __INSTALL_DIR__/config/nginx.conf:/etc/nginx/nginx.conf:ro -v __INSTALL_DIR__/frontend:/usr/share/nginx/html:ro nginx:1.27-alpine
ExecStop=/usr/bin/docker stop clawpro-multi-agent-nginx
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
