TEAMAI_REMOTE_MODE=1
TEAMAI_PUBLIC_ENDPOINT=https://clawpro.example.com
TEAMAI_REMOTE_DEVICE_NAME=ClawPro-Remote-TeamAI
TEAMAI_REMOTE_IWIKI_AUTHORIZED=0

# 可选：服务端 CloudAgent 网关，不配置时不启用。
# CLOUDAGENT_GATEWAY_URL=https://gateway.example.com
# CLOUDAGENT_GATEWAY_PATH=/v1/agents/{agent_id}/run
# CLOUDAGENT_API_KEY_HEADER=x-api-key
# CLOUDAGENT_API_KEY=请使用服务器专用凭证

# 可选：AgentOS 通用 Agent。
# AGENTOS_BASE_URL=https://www.codebuddy.cn/v2/agentos
# AGENTOS_API_KEY=请使用服务器专用凭证
# AGENTOS_RUNTIME_ID=
# AGENTOS_RUNTIME_NAME=clawpro-agent
