{
  "categories": [
    {
      "type": "builtin",
      "label": "内置规则",
      "rule_groups": [
        {
          "key": "allow_internet",
          "name": "允许公网访问",
          "rules": [
            {
              "direction": "egress",
              "protocol": "ALL",
              "port": "ALL",
              "cidr_block": "0.0.0.0/0",
              "ipv6_cidr": "",
              "action": "ACCEPT",
              "description": "放通所有出站流量（IPv4）"
            },
            {
              "direction": "egress",
              "protocol": "ALL",
              "port": "ALL",
              "cidr_block": "",
              "ipv6_cidr": "::/0",
              "action": "ACCEPT",
              "description": "放通所有出站流量（IPv6）"
            }
          ]
        }
      ]
    },
    {
      "type": "recommended",
      "label": "ClawPro 推荐规则",
      "rule_groups": [
        {
          "key": "allow_gateway_ui",
          "name": "OpenClaw 面板端口",
          "condition": "gateway_ui_enable",
          "rules": [
            {
              "direction": "ingress",
              "protocol": "TCP",
              "port": "{{GATEWAY_UI_PORT}}",
              "cidr_block": "0.0.0.0/0",
              "ipv6_cidr": "",
              "action": "ACCEPT",
              "description": "放通 OpenClaw 面板端口"
            }
          ]
        },
        {
          "key": "allow_agent_proxy_teams",
          "name": "Teams Webhook 端口",
          "condition": "agent_proxy_teams_enable",
          "rules": [
            {
              "direction": "ingress",
              "protocol": "TCP",
              "port": "3978",
              "cidr_block": "0.0.0.0/0",
              "ipv6_cidr": "",
              "action": "ACCEPT",
              "description": "放通 Teams Bot Framework Webhook 端口"
            }
          ]
        },
        {
          "key": "allow_agent_proxy_line",
          "name": "LINE Webhook 端口",
          "condition": "agent_proxy_line_enable",
          "rules": [
            {
              "direction": "ingress",
              "protocol": "TCP",
              "port": "8646",
              "cidr_block": "0.0.0.0/0",
              "ipv6_cidr": "",
              "action": "ACCEPT",
              "description": "放通 LINE Messaging API Webhook 端口"
            }
          ]
        },
